{
	"require": {
		"php": "^8.2"
	},
	"require-dev": {
		"wp-cli/i18n-command": "~2.6",
		"squizlabs/php_codesniffer": "~3.13",
		"dealerdirect/phpcodesniffer-composer-installer": "~1.2",
		"wp-coding-standards/wpcs": "~3.3"
	},
	"scripts": {
		"build": "composer run build:pot",
		"build:pot": "wp i18n make-pot . languages/wp-backstage.pot",
		"clean": ["composer run clean:pot", "composer run clean:deps"],
		"clean:deps": "rm -rf vendor composer.lock",
		"clean:pot": "rm languages/wp-backstage.pot",
		"lint": ["composer run lint:php"],
		"lint:php": ["php -l", "./vendor/bin/phpcs"],
		"fix": ["composer run fix-php"],
		"fix:php": "./vendor/bin/phpcbf",
		"version": "@php scripts/version.php"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
