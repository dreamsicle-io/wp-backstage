#: includes/class-wp-backstage-post-type.php:802
msgctxt "discussion settings help tab - trackbacks"
msgid "<strong>Send Trackbacks</strong> — Trackbacks are a way to notify legacy blog systems that you've linked to them. Enter the URL(s) you want to send trackbacks. If you link to other WordPress sites they'll be notified automatically using pingbacks, and this field is unnecessary."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:810
#, php-format
msgctxt "discussion settings help tab - comments"
msgid "<strong>Discussion</strong> — You can turn comments and pings on or off, and if there are comments on the %1$s, you can see them here and moderate them."
msgstr ""

#: includes/class-wp-backstage-post-type.php:857
msgctxt "post publish settings help tab - overview"
msgid "Several boxes on this screen contain settings for how your content will be published, including:"
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:863
#, php-format
msgctxt "post publish settings help tab - publish"
msgid "<strong>Publish</strong> — You can set the terms of publishing your %1$s in the Publish box. For Status, Visibility, and Publish (immediately), click on the Edit link to reveal more options. Visibility includes options for password-protecting a %1$s. The Password protected option allows you to set an arbitrary password for each %1$s. The Private option hides the %1$s from everyone except editors and administrators. Publish (immediately) allows you to set a future or past date and time, so you can schedule a %1$s to be published in the future or backdate a %1$s."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:869
#, php-format
msgctxt "post publish settings help tab - format"
msgid "<strong>Format</strong> — Formats designate how your theme will display a specific %1$s. For example, you could have a <em>standard</em> %1$s with a title and paragraphs, or a short <em>aside</em> that omits the title and contains a short text blurb. Your theme could enable all or some of 10 possible formats. <a href=\"https://wordpress.org/support/article/post-formats/\" target=\"_blank\" rel=\"noopener\">Learn more about formats</a>."
msgstr ""

#. translators: 1: featured image label, 2: post type singular name.
#: includes/class-wp-backstage-post-type.php:876
#, php-format
msgctxt "post publish settings help tab - thumbnail"
msgid "<strong>%1$s</strong> — This allows you to associate an image with your %2$s without inserting it. This is usually useful only if your theme makes use of the image as a thumbnail on the home page, a custom header, etc."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:884
msgctxt "post publish settings help tab - excerpt"
msgid "<strong>Excerpt</strong> — Excerpts are optional hand-crafted summaries of your content that can be used in your theme. <a href=\"https://wordpress.org/support/article/excerpt/\" target=\"_blank\" rel=\"noopener\">Learn more about manual excerpts</a>."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:891
#, php-format
msgctxt "post publish settings help tab - slug"
msgid "<strong>Slug</strong> — The slug of the post is a unique, URL-friendly identifier of the %1$s and will be used when constructing the permalink. <a href=\"https://wordpress.org/support/article/using-permalinks/\" target=\"_blank\" rel=\"noopener\">Learn more about permalinks</a>."
msgstr ""

#. translators: 1: post type singular name, 2: post type plural name.
#: includes/class-wp-backstage-post-type.php:898
#, php-format
msgctxt "post publish settings help tab - page attributes order"
msgid "<strong>%1$s Attributes</strong> — Set the numerical order of this %1$s. This can be used to sort the %2$s when querying them."
msgstr ""

#. translators: 1: post type singular name, 2: post type plural name.
#: includes/class-wp-backstage-post-type.php:906
#, php-format
msgctxt "post publish settings help tab - page attributes hierarchy"
msgid "The parent %1$s can be set here inorder to create a hierarchy of %2$s."
msgstr ""

#: includes/class-wp-backstage-post-type.php:912
msgctxt "post publish settings help tab - page attributes learn more"
msgid "<a href=\"https://make.wordpress.org/support/user-manual/pages/page-attributes/\" target=\"_blank\" rel=\"noopener\">Learn more about attributes</a>."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:917
#, php-format
msgctxt "post publish settings help tab - author"
msgid "<strong>Author</strong> — The user attributed as the author of the %1$s."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:924
#, php-format
msgctxt "post publish settings help tab - custom fields"
msgid "<strong>Custom Fields</strong> — Custom fields can be used to add extra metadata to the %1$s that you can use in your theme. <a href=\"https://wordpress.org/support/article/custom-fields/\" target=\"_blank\" rel=\"noopener\">Learn more about custom fields</a>."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:931
#, php-format
msgctxt "post publish settings help tab - revisions"
msgid "<strong>Revisions</strong> — This allows you to view the %1$s revisions. <a href=\"https://wordpress.org/support/article/revisions/\" target=\"_blank\" rel=\"noopener\">Learn more about revisions</a>."
msgstr ""

#. translators: 1: taxonomy plural name, 2: post type singular name, 3: post type plural name.
#: includes/class-wp-backstage-post-type.php:939
#, php-format
msgctxt "post publish settings help tab - taxonomy"
msgid "<strong>%1$s</strong> ― Manage the %1$s attached to the %2$s. <a href=\"https://wordpress.org/support/article/taxonomies/\" target=\"_blank\" rel=\"noopener\">Learn more about taxonomies</a>."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:1010
#, php-format
msgctxt "post inserting media help tab - overview"
msgid "You can upload and insert media (images, audio, documents, etc.) by clicking the Add Media button. You can select from the images and files already uploaded to the Media Library, or upload new media to add to your %1$s. To create an image gallery, select the images to add and click the “Create a new gallery” button.<br/><br/>You can also embed media from many popular websites including Twitter, YouTube, Flickr and others by pasting the media URL on its own line into the content of your %1$s. <a href=\"https://wordpress.org/support/article/embeds/\" target=\"_blank\" rel=\"noopener\">Learn more about embeds</a>."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:1052
#, php-format
msgctxt "post title and editor help tab - title support"
msgid "<strong>Title</strong> — Enter a title for your %1$s."
msgstr ""

#: includes/class-wp-backstage-post-type.php:1057
msgctxt "post title and editor help tab - permalink support"
msgid "After you enter a title, you'll see the permalink below if the post, which you can edit."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:1066
#, php-format
msgctxt "post title and editor help tab - editor support"
msgid "<strong>Editor</strong> — Enter the text for your %1$s. There are two modes of editing: Visual and Text. Choose the mode by clicking on the appropriate tab.<br/><br/>Visual mode gives you an editor that is similar to a word processor. Click the Toolbar Toggle button to get a second row of controls.<br/><br/>The Text mode allows you to enter HTML along with your %1$s text. Note that &lt;p&gt; and &lt;br&gt; tags are converted to line breaks when switching to the Text editor to make it less cluttered. When you type, a single line break can be used instead of typing &lt;br&gt;, and two line breaks instead of paragraph tags. The line breaks are converted back to tags automatically.<br/><br/>You can insert media files by clicking the button above the editor and following the directions. You can align or edit images using the inline formatting toolbar available in Visual mode.<br/><br/>You can enable distraction-free writing mode using the icon to the right. This feature is not available for old browsers or devices with small screens, and requires that the full-height editor be enabled in Screen Options.<br/><br/>Keyboard users: When you are working in the visual editor, you can use <code>Alt + F10</code> to access the toolbar."
msgstr ""

#. translators: 1: post type singular name, 2: list of meta box titles.
#: includes/class-wp-backstage-post-type.php:1117
#, php-format
msgctxt "post customize display help tab - overview"
msgid "The title field and the big %1$s Editing Area are fixed in place, but you can reposition all the other boxes using drag and drop. You can also minimize or expand them by clicking the title bar of each box. Use the Screen Options tab to unhide more boxes (%2$s) or to choose a 1- or 2-column layout for this screen."
msgstr ""

#. translators: 1: post type plural name, 2: post type singular name.
#: includes/class-wp-backstage-post-type.php:1158
#, php-format
msgctxt "post bulk actions help tab - overview"
msgid "You can also edit or move multiple %1$s to the Trash at once. Select the %1$s you want to act on using the checkboxes, then select the action you want to take from the Bulk actions menu and click Apply.<br/><br/>When using Bulk Edit, you can change the metadata for all selected %1$s at once. To remove a %2$s from the grouping, just click the x next to its name in the Bulk Edit area that appears."
msgstr ""

#. translators: 1: post type plural name, 2: post type singular name.
#: includes/class-wp-backstage-post-type.php:1199
#, php-format
msgctxt "post available actions help tab - overview"
msgid "Hovering over a row in the %1$s list will display action links that allow you to manage your %2$s. You can perform the following actions:"
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:1219
#, php-format
msgctxt "post available actions help tab - edit action"
msgid "<strong>Edit</strong> takes you to the editing screen for that %1$s. You can also reach that screen by clicking on the %1$s title."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:1224
#, php-format
msgctxt "post available actions help tab - quick edit action"
msgid "<strong>Quick Edit</strong> provides inline access to the metadata of your %1$s, allowing you to update %1$s details without leaving this screen."
msgstr ""

#. translators: 1: post type singular name.
#: includes/class-wp-backstage-post-type.php:1229
